# ============================================================
# LaunchPilot — Environment Variables
# Copy this file to web/.env.local and fill in your values
# ============================================================

# ── GitHub ───────────────────────────────────────────────────
# Create at: github.com/settings/tokens → New classic token
# Required scopes: repo, read:org
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sentry ───────────────────────────────────────────────────
# Auth token: sentry.io → Settings → API → Auth Tokens
# Required scopes: project:read, event:read, org:read
SENTRY_TOKEN=sntryu_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# ── PostHog ──────────────────────────────────────────────────
# Get at: app.posthog.com → Project Settings → API Keys
POSTHOG_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_PROJECT_ID=12345

# ── Stripe ───────────────────────────────────────────────────
# Get at: dashboard.stripe.com/test/apikeys
# Use sk_test_ key for development
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Beehiiv ⭐ Community Source ───────────────────────────────
# Get at: app.beehiiv.com → Settings → API
BEEHIIV_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
BEEHIIV_PUBLICATION_ID=pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Dub ⭐ Community Source ───────────────────────────────────
# Get at: app.dub.co → Settings → API
DUB_API_KEY=dub_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Coral (auto-detected) ────────────────────────────────────
# Coral is called as a CLI subprocess. Make sure `coral` is in PATH.
# On Windows with WSL, set the full path:
# CORAL_BIN=wsl /home/<username>/.cargo/bin/coral
CORAL_BIN=

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=LaunchPilot
NEXT_PUBLIC_APP_URL=http://localhost:3000
