# ============================================================
# LaunchPilot — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# --- AI (Required) ---
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- GitHub (Required) ---
# Create at: https://github.com/settings/tokens
# Scopes needed: repo, read:org
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Sentry (Required) ---
# Get at: https://sentry.io → Settings → API → Auth Tokens
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# --- PostHog (Required) ---
# Get at: https://app.posthog.com → Project Settings → API Keys
POSTHOG_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_PROJECT_ID=12345

# --- Stripe (Required — test mode is fine!) ---
# Get at: https://dashboard.stripe.com/test/apikeys
# Use sk_test_ key for demo
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Beehiiv (Required — you built this source!) ---
# Get at: https://app.beehiiv.com → Settings → API
BEEHIIV_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
BEEHIIV_PUBLICATION_ID=pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Dub (Required — you built this source!) ---
# Get at: https://app.dub.co → Settings → API
DUB_API_KEY=dub_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- App Config ---
NEXT_PUBLIC_APP_NAME=LaunchPilot
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Coral (auto-detected from PATH) ---
# Coral is called via CLI. Make sure `coral` is in your PATH.
# Run: coral --version to verify
CORAL_WORKSPACE_PATH=./coral-config
